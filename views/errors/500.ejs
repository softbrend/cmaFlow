<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Error · CMA-Flow</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="auth-shell">
    <div class="form-card" style="text-align:center;">
      <div class="form-title">Something went wrong</div>
      <p class="form-hint">
        <% if (typeof message !== 'undefined' && message) { %><%= message %><% } else { %>Please try again in a moment.<% } %>
      </p>
      <a class="btn btn-accent" href="/">Back to CMA-Flow</a>
    </div>
  </div>
</body>
</html>
