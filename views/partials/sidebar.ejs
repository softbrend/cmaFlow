<aside class="sidebar">
  <div class="nav-heading">Navigation</div>

  <ul class="nav-list">
    <%
      // isExpertEvaluator: kept this name (rather than renaming every
      // reference below) even though, as of 2 October 2026, it now also
      // covers Business Owner Evaluator — both roles pick an SME business
      // category at signup and use the exact same /sme-templates "default
      // CSV for evaluation" system (routes/templates.js's
      // usesTemplateSystem()), so both get "Download SME Templates" in
      // place of "Monetization discovery"/the plain Upload-only nav below.
      // SME Owner-TAM Evaluator (added 4 October 2026) uses the same
      // /sme-templates system, so it is covered here too.
      var isExpertEvaluator = currentUser && (currentUser.role === 'Template Evaluator' || currentUser.role === 'Business Owner Evaluator' || currentUser.role === 'SME Owner-TAM Evaluator');
      var hasUserManual = currentUser && (currentUser.role === 'Business Owner Evaluator' || currentUser.role === 'SME Owner-TAM Evaluator');
      // Nav-link text for the evaluation link itself still needs its own
      // three-way label, since the two template-system roles don't share
      // a page title.
      var evalRoleLabel = currentUser && currentUser.role === 'Template Evaluator' ? 'Template Evaluator Evaluation'
        : currentUser && currentUser.role === 'Business Owner Evaluator' ? 'Business Owner Evaluator Evaluation'
        : currentUser && currentUser.role === 'SME Owner-TAM Evaluator' ? 'SME Owner-TAM Evaluation'
        : 'End-User Evaluation';
    %>
    <% if (currentUser && currentUser.role === 'Admin') { %>
      <%# Admin's own nav: the same four analytics stages an SME owner
          sees (read-only here — an Admin views them via "View analytics"
          on Manage Datasets, routes/dashboard.js's resolveAccountId()),
          then the admin-only tools — now split into an SME-owner set and
          a Template Evaluator set (added 30 September 2026) so the two
          populations' accounts, datasets, and TAM evaluation reports are
          never browsed from the same list. No Upload/Browse/Monetization
          discovery/End-User Evaluation — those are SME-owner/Expert-
          Evaluator actions an Admin account never performs on its own
          account. %>
      <li><a href="/admin" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'home') ? 'active' : '' %>"><span class="nav-dot"></span>Admin home</a></li>
      <% (navSections || []).forEach(function(s) { %>
        <li><a href="/<%= s.slug %>" class="<%= active === s.slug ? 'active' : '' %>"><span class="nav-icon stage-<%= s.slug %>"><%= s.icon %></span><%= s.label %></a></li>
      <% }); %>
      <li><a href="/admin/evaluations" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'evaluations') ? 'active' : '' %>"><span class="nav-dot"></span>View Evaluation Report</a></li>
      <li><a href="/admin/accounts" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'accounts') ? 'active' : '' %>"><span class="nav-dot"></span>Manage SME Accounts</a></li>
      <li><a href="/admin/datasets" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'datasets') ? 'active' : '' %>"><span class="nav-dot"></span>Manage Datasets</a></li>
      <li><a href="/admin/expert-evaluations" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'expert-evaluations') ? 'active' : '' %>"><span class="nav-dot"></span>View Template Evaluation Report</a></li>
      <li><a href="/admin/expert-accounts" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'expert-accounts') ? 'active' : '' %>"><span class="nav-dot"></span>Manage Template Evaluators</a></li>
      <li><a href="/admin/expert-datasets" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'expert-datasets') ? 'active' : '' %>"><span class="nav-dot"></span>Template Evaluator Datasets</a></li>
      <%# Business Owner Evaluator (added 2 October 2026) — its own
          three admin pages, same "never listed alongside another
          population" discipline as the Template Evaluator set above. %>
      <li><a href="/admin/business-owner-evaluations" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'business-owner-evaluations') ? 'active' : '' %>"><span class="nav-dot"></span>View Business Owner Evaluation Report</a></li>
      <li><a href="/admin/business-owner-accounts" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'business-owner-accounts') ? 'active' : '' %>"><span class="nav-dot"></span>Manage Business Owner Evaluators</a></li>
      <li><a href="/admin/business-owner-datasets" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'business-owner-datasets') ? 'active' : '' %>"><span class="nav-dot"></span>Business Owner Evaluator Datasets</a></li>
      <%# SME Owner-TAM Evaluator (added 4 October 2026) — its own three
          admin pages, same "never listed alongside another population"
          discipline as the sets above. %>
      <li><a href="/admin/sme-tam-evaluations" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'sme-tam-evaluations') ? 'active' : '' %>"><span class="nav-dot"></span>View SME Owner-TAM Evaluation Report</a></li>
      <li><a href="/admin/sme-tam-activity" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'sme-tam-activity') ? 'active' : '' %>"><span class="nav-dot"></span>SME Owner-TAM Template Activity</a></li>
      <li><a href="/admin/sme-tam-accounts" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'sme-tam-accounts') ? 'active' : '' %>"><span class="nav-dot"></span>Manage SME Owner-TAM Evaluators</a></li>
      <li><a href="/admin/sme-tam-datasets" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'sme-tam-datasets') ? 'active' : '' %>"><span class="nav-dot"></span>SME Owner-TAM Evaluator Datasets</a></li>
      <li><a href="/admin/gating-comparison" class="<%= (typeof adminSection !== 'undefined' && adminSection === 'gating-comparison') ? 'active' : '' %>"><span class="nav-dot"></span>Gating Comparison</a></li>
    <% } else if (typeof evaluationLocked !== 'undefined' && evaluationLocked) { %>
      <%# New (or not-yet-completed) SME owner, Template Evaluator, OR
          Business Owner Evaluator: every other module is hidden until the
          six-task walkthrough and questionnaire are finished
          (middleware/evaluationGate.js enforces this server-side too, so
          this isn't just cosmetic — see its header comment for exactly
          what stays reachable and why). A Template Evaluator or Business
          Owner Evaluator also gets the template-download page here, since
          either needs a category template before Task 1's upload. %>
      <%# active is 'evaluation-data-browser' (not 'sme-templates') specifically
          on the Browse Evaluation CSV screen — its own wider, Excel-style
          layout, see public/css/style.css's body.stage-evaluation-data-browser
          rules — so this link still has to light up for both values.
          'evaluation-dataset-editor' (added 2 October 2026) is the same
          idea for Business Owner Evaluator's own editable CRUD grid at
          GET /sme-templates/evaluation-dataset — see that route's comment
          in routes/templates.js. %>
      <% if (isExpertEvaluator) { %>
        <li><a href="/sme-templates" class="<%= (active === 'sme-templates' || active === 'evaluation-data-browser' || active === 'evaluation-dataset-editor') ? 'active' : '' %>"><span class="nav-dot"></span>Download SME Templates</a></li>
      <% } %>
      <%# active is 'evaluation-questionnaire' (not 'evaluation') specifically
          on the questionnaire screen — its own wider layout, see
          public/css/style.css's body.stage-evaluation-questionnaire rules —
          so this link still has to light up for both values. %>
      <li><a href="/evaluation" class="<%= (active === 'evaluation' || active === 'evaluation-questionnaire') ? 'active' : '' %>"><span class="nav-dot"></span><%= evalRoleLabel %></a></li>
      <%# User Manual (added 3 October 2026) — directly below the
          evaluation link, per Brenda's explicit placement request.
          Business Owner Evaluator only: the content is a step-by-step
          guide written for that role's own process (dataset choice,
          CRUD, the six tasks, the ISO/IEC 25010 questionnaire), so it has
          no reason to appear for SME Owner or Template Evaluator.
          Reachable at every lock state (middleware/evaluationGate.js's
          ALWAYS_ALLOWED_PREFIXES), same as the evaluation link above it —
          this branch is for a still-locked account, exactly who most
          needs it. %>
      <% if (hasUserManual) { %>
        <li><a href="/user-manual" class="<%= active === 'user-manual' ? 'active' : '' %>"><span class="nav-dot"></span>User Manual</a></li>
      <% } %>
    <% } else { %>
      <%# The four analytics stages carry a stage-colored icon chip instead
          of the plain gold nav-dot — the same DESCRIPTIVE → DIAGNOSTIC →
          PREDICTIVE → PRESCRIPTIVE identity as the .stage-pipeline trademark
          on their own pages (see views/partials/stage-pipeline.ejs). Shown
          to every role alike; Monetization discovery vs. the template
          downloads is the only item that differs — SME Owner gets the
          former, Template Evaluator and Business Owner Evaluator (both
          "isExpertEvaluator" above) get the latter. %>
      <% (navSections || []).forEach(function(s) { %>
        <li><a href="/<%= s.slug %>" class="<%= active === s.slug ? 'active' : '' %>"><span class="nav-icon stage-<%= s.slug %>"><%= s.icon %></span><%= s.label %></a></li>
      <% }); %>
      <li><a href="/upload-dataset" class="<%= active === 'upload-new-dataset' ? 'active' : '' %>"><span class="nav-dot"></span>Upload New Dataset</a></li>
      <li><a href="/browse-dataset" class="<%= active === 'browse-dataset' ? 'active' : '' %>"><span class="nav-dot"></span>Browse Dataset</a></li>
      <% if (isExpertEvaluator) { %>
        <li><a href="/sme-templates" class="<%= (active === 'sme-templates' || active === 'evaluation-data-browser' || active === 'evaluation-dataset-editor') ? 'active' : '' %>"><span class="nav-dot"></span>Download SME Templates</a></li>
      <% } else { %>
        <li><a href="/monetization-discovery" class="<%= active === 'monetization-discovery' ? 'active' : '' %>"><span class="nav-dot"></span>Monetization discovery</a></li>
      <% } %>
      <li><a href="/evaluation" class="<%= (active === 'evaluation' || active === 'evaluation-questionnaire') ? 'active' : '' %>"><span class="nav-dot"></span><%= evalRoleLabel %></a></li>
      <%# User Manual — same placement/scoping as the locked branch above. %>
      <% if (hasUserManual) { %>
        <li><a href="/user-manual" class="<%= active === 'user-manual' ? 'active' : '' %>"><span class="nav-dot"></span>User Manual</a></li>
      <% } %>
    <% } %>
  </ul>

  <div class="sidebar-footer">
    <a class="btn btn-danger btn-block" href="/logout">Sign out</a>
  </div>
</aside>
