<div class="page-title">🛡️ <span class="page-title-text">Add admin</span></div>
<p class="page-subtitle">Create a new account with Admin access. This form only exists inside the admin section — there's no public sign-up for it.</p>

<div class="form-card">
  <div class="form-title">New admin account</div>
  <p class="form-hint">The new admin can sign in with this username and password right away.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="alert-error">
      <ul>
        <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/admin/accounts/new" autocomplete="off">
    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= old.username || '' %>" required autofocus />
    </div>

    <div class="field">
      <label for="owner_name">Name</label>
      <input type="text" id="owner_name" name="owner_name" value="<%= old.owner_name || '' %>" required />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= old.email || '' %>" required />
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />
    </div>

    <div class="field">
      <label for="confirm_password">Confirm password</label>
      <input type="password" id="confirm_password" name="confirm_password" required />
    </div>

    <button type="submit" class="btn btn-accent btn-block">Create admin account</button>
  </form>

  <div class="form-footer"><a href="/admin/accounts">← Back to accounts</a></div>
</div>
