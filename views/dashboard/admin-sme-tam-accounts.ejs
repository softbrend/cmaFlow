<div class="page-title">🏢 <span class="page-title-text">Manage SME Owner-TAM Evaluators</span></div>
<p class="page-subtitle">Every SME Owner-TAM Evaluator account registered through the open signup link at <code>/smeOwnerTam-signup</code>. Use Change password to reset one's password on their behalf — no need to know the old one. Kept separate from SME owner, Template Evaluator and Business Owner Evaluator accounts on purpose — see <a href="/admin/accounts">Manage SME Accounts</a>, <a href="/admin/expert-accounts">Manage Template Evaluators</a> and <a href="/admin/business-owner-accounts">Manage Business Owner Evaluators</a> for those.</p>

<% if (passwordReset) { %>
  <div class="alert-success">Password updated for <strong><%= passwordReset %></strong>.</div>
<% } %>

<%- include('_sme-tam-category-summary', { cs: categorySummary }) %>

<div style="display: flex; gap: 10px; margin-bottom: 18px; justify-content: space-between; flex-wrap: wrap;">
  <form method="GET" action="/admin/sme-tam-accounts" style="display: flex; gap: 10px; max-width: 520px; flex: 1;">
    <input type="text" name="q" value="<%= q %>" placeholder="Search username, name, business, or email"
           style="flex: 1; padding: 11px 14px; border-radius: 10px; border: 1px solid transparent; background: var(--bg-input); color: #1c2a20; font-size: 14.5px;" />
    <button type="submit" class="btn btn-ghost">Search</button>
    <% if (q) { %><a class="btn btn-ghost" href="/admin/sme-tam-accounts">Clear</a><% } %>
  </form>
</div>

<div class="form-card wide" style="max-width: none;">
  <div class="table-scroll">
    <table class="table-simple">
      <thead>
        <tr>
          <th>Username</th>
          <th>Name</th>
          <th>Business / affiliation type</th>
          <th>SME business category</th>
          <th>Business size</th>
          <th>Email</th>
          <th>Joined</th>
          <th>TAM evaluation</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (accounts.length === 0) { %>
          <tr><td colspan="9" style="color: var(--text-muted);">No SME Owner-TAM Evaluator accounts match "<%= q %>".</td></tr>
        <% } %>
        <% accounts.forEach(function(a) {
             var ev = evalStatus[a.id] || { state: 'notStarted', items_answered: 0 };
             var evLabel, evClass;
             if (ev.state === 'completed') { evLabel = 'Completed'; evClass = 'badge-active'; }
             else if (ev.state === 'inProgress') { evLabel = 'Not completed — ' + ev.items_answered + '/17'; evClass = 'badge-risk-medium'; }
             else { evLabel = 'Not completed — not started'; evClass = 'badge-inactive'; }
        %>
          <tr>
            <td><%= a.username %></td>
            <td><%= a.owner_name %></td>
            <td><%= a.business_type || '—' %></td>
            <td><%= a.business_sector || '—' %></td>
            <td><%= a.business_size || '—' %></td>
            <td><%= a.email %></td>
            <td><%= new Date(a.created_at).toLocaleDateString() %></td>
            <td style="white-space: nowrap;"><span class="badge <%= evClass %>"><%= evLabel %></span></td>
            <td style="text-align: right; white-space: nowrap;">
              <a class="btn btn-ghost btn-sm" href="/admin/accounts/<%= a.id %>/password">Change password</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
