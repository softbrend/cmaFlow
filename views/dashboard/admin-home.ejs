    <div class="stat-label">Evaluations completed (Expert)</div>
    <div class="stat-value"><%= expertCompleted %></div>
  </div>
  <div class="stat-tile">
    <div class="stat-label">Evaluations in progress (Expert)</div>
    <div class="stat-value"><%= expertInProgress %></div>
  </div>
  <div class="stat-tile">
    <div class="stat-label">Not started yet (Expert)</div>
    <div class="stat-value"><%= expertNotStarted %></div>
  </div>
</div>

<div class="kpi-row" style="margin-top: 14px;">
