<div class="page-title">🏪 <span class="page-title-text"><%= isExpertEvaluator ? 'Template Evaluator Portal' : 'SME Owner Portal' %></span></div>
<p class="page-subtitle">
  <% if (isDirectFlowEvaluator) { %>
    Descriptive, diagnostic, predictive, and prescriptive monetization intelligence for whichever dataset you upload or select below — no set order, no walkthrough steps.
  <% } else { %>
    AD-CMA decision support for the SME account in the assigned dataset: descriptive, diagnostic, predictive, and prescriptive monetization intelligence in one place.
  <% } %>
</p>

<% if (isDirectFlowEvaluator && (!datasets || datasets.length === 0)) { %>
  <div class="form-card wide" style="margin-bottom: 18px;">
    <div class="form-title" style="font-size: 16px;">Choose a dataset to evaluate</div>
    <p class="form-hint" style="margin: 0 0 12px;">Upload your own dataset, or pick one of the 20 ready-made SME templates — either one drives all four analytics modules below.</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <a class="btn btn-accent" href="/upload-dataset">Upload my own dataset →</a>
      <a class="btn btn-outline" href="/sme-templates">Select a template dataset →</a>
    </div>
  </div>
<% } %>

<% if (isDirectFlowEvaluator) { %>
  <div class="form-card wide" style="margin-bottom: 18px;">
    <div class="form-title" style="font-size: 16px;">The four analytics modules</div>
    <p class="form-hint" style="margin: 0 0 12px;">Open these in any order you like.</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <% (navSections || []).forEach(function(s) { %>
        <a class="btn btn-outline" href="/<%= s.slug %>"><%= s.icon %>&nbsp; <%= s.label %></a>
      <% }); %>
    </div>
  </div>
  <p class="form-hint" style="margin: 0 0 18px;">
    When you're ready, the <a href="/evaluation" style="color: var(--accent); text-decoration:underline;">Template Evaluator Evaluation</a> link in the sidebar has the 17-item questionnaire.
  </p>
<% } %>

<% if (!datasets || datasets.length === 0) { %>
  <% if (!isDirectFlowEvaluator) { %>
  <div class="warn-box">
    No dataset is currently assigned to this account.
    &nbsp;<a href="/upload-dataset" style="color: var(--accent); text-decoration:underline;">Upload a dataset →</a>
  </div>
  <% } %>
<% } else { %>
  <div class="info-box">
    <% if (defaultDataset) { %>
      Default dataset: <strong><%= defaultDataset.dataset_name %></strong>
      (<%= defaultDataset.dataset_id %><%= defaultDataset.domain ? ', ' + defaultDataset.domain : '' %>)
    <% } %>
    <% if (datasets.length > 1) { %>
      <form method="POST" action="/default-dataset" style="margin-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
        <input type="hidden" name="redirect_to" value="/" />
        <label for="default-dataset-select" style="font-size:13px; color: var(--text-muted);">
          This account has <%= datasets.length %> uploaded datasets — switch the default:
        </label>
        <select id="default-dataset-select" name="dataset_id">
          <% datasets.forEach(function(d) { %>
            <option value="<%= d.id %>" <%= defaultDataset && d.id === defaultDataset.id ? 'selected' : '' %>>
              <%= d.dataset_name %> (<%= d.dataset_id %>)
            </option>
          <% }); %>
        </select>
        <button type="submit" class="btn btn-outline" style="padding:4px 10px; font-size:12.5px;">Set as default</button>
      </form>
    <% } %>
  </div>
<% } %>

<% if (configs && configs.length > 0) { %>
  <div class="ok-box">
    <strong><%= configs.length %></strong> active monetization configuration<%= configs.length === 1 ? '' : 's' %> for this account.
    <table class="table-simple">
      <thead><tr><th>Name</th><th>Model</th><th>Source</th><th>Created</th></tr></thead>
      <tbody>
        <% configs.forEach(function(c) { %>
          <tr>
            <td><%= c.config_name %></td>
            <td><%= c.model_type.replace(/_/g, ' ') %></td>
            <td>
              <% if (c.details && (c.details.source === 'raw_import' || c.details.source === 'canonical_import')) { %>
                <span class="badge" style="background: rgba(219,165,55,0.2); color: var(--accent);">Derived from data</span>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 12px;">Manual</span>
              <% } %>
            </td>
            <td><%= new Date(c.created_at).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
