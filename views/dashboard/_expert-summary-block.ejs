<%# Partial: one flow's 17-item questionnaire summary block, for
    views/dashboard/admin-expert-evaluations.ejs — included twice there
    (once per evaluation_flow) so a 'walkthrough'-flow respondent's
    ratings are never rendered averaged together with a 'direct'-flow
    one's. Locals: label (string), s (one summarizeCompletedResponses()
    result — { byItem, byDomain, completedCount }). Optional local: totals
    ({ registered, completed, questionnaire, notStarted }) — when the
    including page passes it, the block also states how many evaluator
    accounts exist in total (the SME Owner-TAM report does; the others
    don't, so the line is simply omitted for them). %>
<div class="form-card wide" style="max-width: none; margin-bottom: 26px;">
  <div class="form-title" style="font-size: 18px;">17-item questionnaire — <%= label %> respondents</div>
  <p class="form-hint">
    Based on <strong><%= s.completedCount %></strong> fully completed evaluation<%= s.completedCount === 1 ? '' : 's' %>.
    In-progress evaluations are excluded so partial ratings don't skew the figures.
    %Agree = share of ratings of 4 or 5 (Agree / Strongly Agree) on the 5-point scale.
  </p>

  <% if (typeof totals !== 'undefined' && totals) { %>
    <p class="form-hint" style="margin-top: -10px;">
      <strong>Total <%= label %> evaluators registered: <%= totals.registered %></strong>
      &nbsp;·&nbsp; <%= totals.completed %> completed
      &nbsp;·&nbsp; <%= totals.questionnaire %> questionnaire open
      &nbsp;·&nbsp; <%= totals.notStarted %> not started
    </p>
  <% } %>

  <% if (s.completedCount === 0) { %>
    <div class="placeholder-card">
      <div class="emoji">🧭</div>
      <p>No fully completed <%= label.toLowerCase() %> evaluations yet.</p>
    </div>
  <% } else { %>
    <div class="kpi-row" style="margin-top: 16px;">
      <% s.byDomain.forEach(function(d) { %>
        <div class="stat-tile">
          <div class="stat-label"><%= d.label %> (<%= d.domain %>)</div>
          <div class="stat-value"><%= d.mean !== null ? d.mean.toFixed(2) : '—' %> / 5</div>
          <div class="stat-delta" style="color: var(--text-muted); font-weight: 600;"><%= d.percentAgree !== null ? d.percentAgree.toFixed(0) + '% agree' : '' %></div>
        </div>
      <% }); %>
    </div>

    <% ['PU', 'PEOU', 'BI'].forEach(function(domain) { %>
      <div style="margin-top: 22px;">
        <div class="form-title" style="font-size: 15px; margin-bottom: 6px;"><%= (s.byDomain.find(function(d){ return d.domain === domain; }) || {}).label %> (<%= domain %>)</div>
        <div class="table-scroll">
          <table class="table-simple">
            <thead>
              <tr>
                <th>Item</th>
                <th>Statement</th>
                <th>n</th>
                <th>Mean</th>
                <th>Median</th>
                <th>Q1–Q3</th>
                <th>%Agree</th>
              </tr>
            </thead>
            <tbody>
              <% s.byItem.filter(function(it){ return it.domain === domain; }).forEach(function(it) { %>
                <tr>
                  <td><%= it.code %></td>
                  <td><%= it.text %></td>
                  <td><%= it.n %></td>
                  <td><%= it.mean !== null ? it.mean.toFixed(2) : '—' %></td>
                  <td><%= it.median !== null ? it.median.toFixed(1) : '—' %></td>
                  <td><%= (it.q1 !== null && it.q3 !== null) ? it.q1.toFixed(1) + '–' + it.q3.toFixed(1) : '—' %></td>
                  <td><%= it.percentAgree !== null ? it.percentAgree.toFixed(0) + '%' : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% }); %>
  <% } %>
</div>
