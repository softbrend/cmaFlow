<%
function qs(overrides) {
  var params = Object.assign({}, query, overrides);
  return Object.keys(params)
    .filter(function(k) { return params[k] !== undefined && params[k] !== null && params[k] !== ''; })
    .map(function(k) { return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); })
    .join('&');
}
%>
<div class="page-title">🔎 <span class="page-title-text"><%= dataset.dataset_name %></span></div>
<p class="page-subtitle">
  <a href="/browse-dataset" style="color: var(--accent);">← All datasets</a>
  &nbsp;·&nbsp; Dataset ID: <strong><%= dataset.dataset_id %></strong>
  &nbsp;·&nbsp; File: <strong><%= label %></strong>
  &nbsp;·&nbsp; <a href="/browse-dataset/<%= dataset.id %>/<%= fileType %>/evaluation" style="color: var(--accent); font-weight:600;">🧪 Evaluation Report</a>
</p>

<div class="form-card wide filter-bar" style="margin-bottom: 18px;">
  <div class="filter-bar-head">
    <div class="filter-bar-title">Filters</div>
    <div class="filter-bar-actions">
      <% if (columns.length > 0) { %>
        <button type="submit" form="browse-filter-form" class="btn btn-accent btn-sm">Search</button>
      <% } %>
      <button type="button" class="btn btn-ghost btn-sm" data-filter-toggle>Hide filters</button>
    </div>
  </div>
  <% if (columns.length === 0) { %>
    <p style="color: var(--text-muted); margin: 14px 0 0;">This file has no columns to filter on.</p>
  <% } else { %>
    <form method="GET" id="browse-filter-form" action="/browse-dataset/<%= dataset.id %>/<%= fileType %>" class="filter-bar-body" data-filter-body>
      <div class="filter-bar-row filter-bar-row-search">
        <div class="field filter-field filter-field-search">
          <label>Search</label>
          <input type="text" name="q" placeholder="Search any column — e.g. a customer id, category, status…" value="<%= query.q || '' %>" />
        </div>
      </div>
      <div class="filter-bar-divider"></div>
      <div class="filter-bar-grid">
        <% columnMeta.forEach(function(meta) { %>
          <div class="field filter-field">
            <label><%= meta.name %></label>
            <% if (meta.type === 'select') { %>
              <select name="f_<%= meta.name %>">
                <option value="">All</option>
                <% meta.options.forEach(function(opt) { %>
                  <option value="<%= opt %>" <%= query['f_' + meta.name] === opt ? 'selected' : '' %>><%= opt %></option>
                <% }); %>
              </select>
            <% } else if (meta.type === 'number') { %>
              <div style="display:flex; gap:6px;">
                <input type="number" name="fmin_<%= meta.name %>" placeholder="Min (<%= meta.min %>)" value="<%= query['fmin_' + meta.name] || '' %>" style="width:50%;" />
                <input type="number" name="fmax_<%= meta.name %>" placeholder="Max (<%= meta.max %>)" value="<%= query['fmax_' + meta.name] || '' %>" style="width:50%;" />
              </div>
            <% } else { %>
              <input type="text" name="f_<%= meta.name %>" placeholder="Contains…" value="<%= query['f_' + meta.name] || '' %>" />
            <% } %>
          </div>
        <% }); %>
      </div>

      <div class="filter-bar-row filter-bar-row-actions">
        <button type="submit" class="btn btn-accent">Apply filters</button>
        <a href="/browse-dataset/<%= dataset.id %>/<%= fileType %>" class="btn btn-ghost">Clear filters</a>
      </div>
    </form>
  <% } %>
</div>

<script>
(function () {
  // Collapsible filters panel — mirrors Final Grade Encoding's "Hide class
  // list" pattern. Purely a display toggle (no filters are cleared), so
  // hiding the panel never discards a search already typed in; re-showing
  // it brings everything back exactly as left.
  var toggle = document.querySelector('[data-filter-toggle]');
  var body = document.querySelector('[data-filter-body]');
  if (toggle && body) {
    toggle.addEventListener('click', function () {
      var hidden = body.style.display === 'none';
      body.style.display = hidden ? '' : 'none';
      toggle.textContent = hidden ? 'Hide filters' : 'Show filters';
    });
  }
})();
</script>

<div class="form-card wide">
  <div class="form-title">Records</div>
  <p class="form-hint">
    Showing <%= pageRows.length === 0 ? 0 : (page - 1) * pageSize + 1 %>–<%= (page - 1) * pageSize + pageRows.length %>
    of <%= filteredCount %> matching row<%= filteredCount === 1 ? '' : 's' %>
    <% if (filteredCount !== totalRows) { %> (<%= totalRows %> total)<% } %>
  </p>

  <% if (pageRows.length === 0) { %>
    <p style="color: var(--text-muted);">No rows match the current filters.</p>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table class="table-simple">
        <thead>
          <tr><% columns.forEach(function(c) { %><th><%= c %></th><% }); %></tr>
        </thead>
        <tbody>
          <% pageRows.forEach(function(row) { %>
            <tr><% columns.forEach(function(c) { %><td><%= row[c] %></td><% }); %></tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:16px; flex-wrap:wrap; gap:10px;">
      <div style="font-size:13px; color:var(--text-muted);">Page <%= page %> of <%= totalPages %></div>
      <div style="display:flex; gap:8px;">
        <% if (page > 1) { %>
          <a class="btn btn-ghost" href="?<%= qs({ page: page - 1 }) %>">← Prev</a>
        <% } %>
        <% if (page < totalPages) { %>
          <a class="btn btn-ghost" href="?<%= qs({ page: page + 1 }) %>">Next →</a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
