<div class="page-title">🏢 <span class="page-title-text">Manage Business Owner Evaluators</span></div>
<p class="page-subtitle">Every Business Owner Evaluator account registered through the access-code signup at <code>/businessOwner-signup</code>. Use Change password to reset one's password on their behalf — no need to know the old one. Kept separate from SME owner and Template Evaluator accounts on purpose — see <a href="/admin/accounts">Manage SME Accounts</a> and <a href="/admin/expert-accounts">Manage Template Evaluators</a> for those.</p>

<% if (passwordReset) { %>
  <div class="alert-success">Password updated for <strong><%= passwordReset %></strong>.</div>
<% } %>

<div style="display: flex; gap: 10px; margin-bottom: 18px; justify-content: space-between; flex-wrap: wrap;">
  <form method="GET" action="/admin/business-owner-accounts" style="display: flex; gap: 10px; max-width: 520px; flex: 1;">
    <input type="text" name="q" value="<%= q %>" placeholder="Search username, name, business, or email"
           style="flex: 1; padding: 11px 14px; border-radius: 10px; border: 1px solid transparent; background: var(--bg-input); color: #1c2a20; font-size: 14.5px;" />
    <button type="submit" class="btn btn-ghost">Search</button>
    <% if (q) { %><a class="btn btn-ghost" href="/admin/business-owner-accounts">Clear</a><% } %>
  </form>
</div>

<div class="form-card wide" style="max-width: none;">
  <div class="table-scroll">
    <table class="table-simple">
      <thead>
        <tr>
          <th>Username</th>
          <th>Owner name</th>
          <th>Business name</th>
          <th>Sector</th>
          <th>Region</th>
          <th>Email</th>
          <th>Joined</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (accounts.length === 0) { %>
          <tr><td colspan="8" style="color: var(--text-muted);">No Business Owner Evaluator accounts match "<%= q %>".</td></tr>
        <% } %>
        <% accounts.forEach(function(a) { %>
          <tr>
            <td><%= a.username %></td>
            <td><%= a.owner_name %></td>
            <td><%= a.business_name %></td>
            <td><%= a.business_sector || '—' %></td>
            <td><%= a.business_region || '—' %></td>
            <td><%= a.email %></td>
            <td><%= new Date(a.created_at).toLocaleDateString() %></td>
            <td style="text-align: right; white-space: nowrap;">
              <a class="btn btn-ghost btn-sm" href="/admin/accounts/<%= a.id %>/password">Change password</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
