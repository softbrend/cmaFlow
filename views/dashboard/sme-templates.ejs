<div class="page-title">📄 <span class="page-title-text">Download SME Templates</span></div>
<% if (assignedCategory) { %>
  <p class="page-subtitle">You selected <strong><%= assignedCategory %></strong> at signup — its row is highlighted below. Download its CSV template, fill it with a realistic dataset, then upload it<%= isDirectFlow ? '' : ' as your Task 1' %>.<% if (isExpertEvaluator) { %> Every template already ships with 50 synthetic rows built to drive real output across all four analytics modules — pick one below as your "default CSV for evaluation" to browse and cross-check its exact values against the reports CMA-Flow generates.<% } %></p>
<% } else { %>
  <p class="page-subtitle">Pick the business category closest to the dataset you're preparing, and download its CSV template — the exact column set CMA-Flow expects for that category. Fill it with a realistic dataset of your own choosing, then upload it<%= isDirectFlow ? '' : ' as your Task 1' %>.</p>
<% } %>

<div class="form-card wide" style="margin-bottom: 22px;">
  <div class="form-title" style="font-size: 15px;">Two kinds of template download</div>
  <p class="form-hint" style="margin-bottom: 0;"><strong>Download CSV</strong> gives you the template with 50 sample rows already filled in, so you can see how it should look. <strong>Download blank CSV</strong> gives you the same columns with no rows — fill it in with your own business records, then upload it back at <a href="/upload-dataset">Upload Dataset</a>.</p>
</div>

<div class="form-card wide" style="margin-bottom: 22px;">
  <div class="form-title" style="font-size: 15px;">Reference materials</div>
  <p class="form-hint" style="margin-bottom: 10px;">Common fields are intentionally repeated across categories to support CMA-Flow's schema profiling and semantic-role detection. See the full field dictionary for every column's suggested data type and which analytics stage(s) it feeds.</p>
  <a class="btn btn-ghost btn-sm" href="/sme-templates/reference/field-data-dictionary">Download full field data dictionary</a>
  <a class="btn btn-ghost btn-sm" href="/sme-templates/reference/analytics-guidance">Download analytics-readiness guidance</a>
</div>

<% if (isExpertEvaluator) { %>
  <div class="form-card wide" style="margin-bottom: 22px;">
    <div class="form-title" style="font-size: 15px;">Default CSV for evaluation</div>
    <% if (evaluationTemplateFile) {
         var defaultRow = manifest.find(function (r) { return r.template_file === evaluationTemplateFile; }); %>
      <p class="form-hint" style="margin-bottom: 10px;">You're currently using <strong><%= defaultRow ? defaultRow.sme_business_category : evaluationTemplateFile %></strong> as your default CSV for evaluation<% if (isBusinessOwner) { %> — add, edit, or delete rows on its own page and the four analytics modules (Descriptive, Diagnostic, Predictive, Prescriptive) will reflect your changes next time you open them. Each category you pick below keeps its own separate, editable copy under its own dataset ID — picking a different one never erases this one.<% } else { %> — its 50 rows are what you'll browse and filter below. Pick "Use for evaluation" on a different row any time to switch.<% } %></p>
      <% if (isBusinessOwner) { %>
        <a class="btn btn-accent btn-sm" href="/sme-templates/evaluation-dataset/<%= categoryToDatasetRowId[defaultRow ? defaultRow.sme_business_category : ''] %>">Open editable dataset (add rows) →</a>
        <a class="btn btn-ghost btn-sm" href="/sme-templates/evaluation-dataset">View all your dataset copies</a>
        <p class="form-hint" style="margin: 10px 0 0;">Prefer to work from a blank sheet instead? Use <strong>Start blank (my own data)</strong> on any row below — every row in that copy is real data you type in yourself, so you get full add / edit / delete there, not just Add.</p>
      <% } else { %>
        <a class="btn btn-accent btn-sm" href="/sme-templates/evaluation-data">Browse records in table format</a>
      <% } %>
    <% } else { %>
      <p class="form-hint" style="margin-bottom: 0;">Pick "Use for evaluation" on any row below to set that template's 50 synthetic rows as your reference dataset — you'll then be able to browse and filter them in a table to check record values against the generated reports.</p>
    <% } %>
  </div>
<% } %>

<div class="form-card wide" style="max-width: none;">
  <div class="table-scroll">
    <table class="table-simple">
      <thead>
        <tr>
          <th>Business category</th>
          <th>Examples</th>
          <th>Fields</th>
          <th>Analytics supported</th>
          <th></th>
          <% if (isExpertEvaluator) { %><th></th><% } %>
          <% if (isBusinessOwner) { %><th></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% manifest.forEach(function(row) {
             var isAssigned = assignedCategory && row.sme_business_category === assignedCategory;
             var isEvalDefault = isExpertEvaluator && evaluationTemplateFile === row.template_file; %>
          <tr<% if (isAssigned || isEvalDefault) { %> style="background: var(--bg-input);"<% } %>>
            <td><%= row.sme_business_category %><% if (isAssigned) { %> <span class="badge badge-active" style="margin-left: 6px;">Your category</span><% } %><% if (isEvalDefault) { %> <span class="badge badge-active" style="margin-left: 6px;">★ Default for evaluation</span><% } %></td>
            <td style="color: var(--text-muted); font-size: 13px;"><%= row.examples %></td>
            <td><%= row.field_count %></td>
            <td style="color: var(--text-muted); font-size: 13px;"><%= row.analytics_supported %></td>
            <td style="text-align: right; white-space: nowrap;">
              <a class="btn btn-accent btn-sm" href="/sme-templates/download/<%= row.template_file %>">Download CSV</a>
              <a class="btn btn-ghost btn-sm" href="/sme-templates/download-blank/<%= row.template_file %>" title="Headers only — no sample rows. Fill it with your own records, then upload it back at Upload Dataset.">Download blank CSV</a>
            </td>
            <% if (isExpertEvaluator) { %>
              <%
                // Business Owner Evaluator only (added 3 October 2026,
                // alongside the multi-copy model): categoryToDatasetRowId
                // tells us whether this account already has ITS OWN copy
                // of this particular category, independent of whether
                // that copy is the current default (isEvalDefault) —
                // Template Evaluator has no such map (it only ever has
                // the one copy total, already fully described by
                // isEvalDefault alone), so ownDatasetRowId stays
                // undefined and the plain Template Evaluator branch below
                // is unchanged from before this round.
                var ownDatasetRowId = isBusinessOwner && categoryToDatasetRowId ? categoryToDatasetRowId[row.sme_business_category] : null;
              %>
              <td style="text-align: right; white-space: nowrap;">
                <% if (isBusinessOwner) { %>
                  <% if (ownDatasetRowId) { %>
                    <a class="btn btn-ghost btn-sm" href="/sme-templates/evaluation-dataset/<%= ownDatasetRowId %>">Edit records</a>
                    <% if (!isEvalDefault) { %>
                      <form method="POST" action="/sme-templates/evaluation-dataset/<%= ownDatasetRowId %>/set-current" style="display:inline;">
                        <button type="submit" class="btn btn-ghost btn-sm">Set as current</button>
                      </form>
                    <% } %>
                  <% } else { %>
                    <form method="POST" action="/sme-templates/set-evaluation-default" style="display:inline;">
                      <input type="hidden" name="template_file" value="<%= row.template_file %>" />
                      <button type="submit" class="btn btn-ghost btn-sm">Use for evaluation</button>
                    </form>
                  <% } %>
                <% } else { %>
                  <% if (isEvalDefault) { %>
                    <a class="btn btn-ghost btn-sm" href="/sme-templates/evaluation-data">Browse records</a>
                  <% } else { %>
                    <form method="POST" action="/sme-templates/set-evaluation-default" style="display:inline;">
                      <input type="hidden" name="template_file" value="<%= row.template_file %>" />
                      <button type="submit" class="btn btn-ghost btn-sm">Use for evaluation</button>
                    </form>
                  <% } %>
                <% } %>
              </td>
            <% } %>
            <% if (isBusinessOwner) { %>
              <%
                // Blank track's own per-row action — fully independent of
                // the prefilled column just above, since an account can
                // hold both a prefilled AND a blank copy of the same
                // category at once (two separate dataset_ids — see
                // services/templateEvaluationIngest.js). ownBlankId comes
                // from categoryToBlankDatasetRowId (routes/templates.js's
                // GET /sme-templates), built the same way ownDatasetRowId
                // is, just filtered to EVALBLANK_* instead.
                var ownBlankId = categoryToBlankDatasetRowId ? categoryToBlankDatasetRowId[row.sme_business_category] : null;
              %>
              <td style="text-align: right; white-space: nowrap;">
                <% if (ownBlankId) { %>
                  <a class="btn btn-ghost btn-sm" href="/sme-templates/evaluation-dataset/<%= ownBlankId %>">Edit my data</a>
                <% } else { %>
                  <form method="POST" action="/sme-templates/start-blank" style="display:inline;">
                    <input type="hidden" name="template_file" value="<%= row.template_file %>" />
                    <button type="submit" class="btn btn-ghost btn-sm">Start blank (my own data)</button>
                  </form>
                <% } %>
              </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
