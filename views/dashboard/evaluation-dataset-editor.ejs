<div class="page-title">✏️ <span class="page-title-text">Edit Your Evaluation Dataset</span></div>
<p class="page-subtitle">
  <% if (categoryLabel) { %><strong><%= categoryLabel %></strong> — <% } %><%= records.length %> row<%= records.length === 1 ? '' : 's' %>, this is your own working copy of this category's template — separate from the shared template CSV, and separate from any other category's copy you hold. Click any cell to edit it (like a spreadsheet) — it saves automatically when you click away. Add or delete rows below. Changes here are picked up the next time you open one of the four analytics modules, if this copy is your current default dataset.
  <a href="/sme-templates/evaluation-dataset" style="margin-left: 6px;">All your dataset copies</a> ·
  <a href="/sme-templates">Download SME Templates</a>
</p>

<div id="eval-editor-alert" class="alert-error" style="display:none;" role="alert"></div>

<% if (columns.length === 0) { %>
  <div class="form-card wide data-browser-card" style="max-width: none;">
    <p class="form-hint" style="margin: 0;">This dataset copy has no rows, so there are no columns to show or edit. Go back to Download SME Templates and pick a business category to get a fresh copy to work with.</p>
  </div>
<% } else { %>
  <div class="form-card wide data-browser-card" style="margin-bottom: 18px;">
    <div style="display:flex; align-items:center; justify-content:space-between; gap: 14px; flex-wrap: wrap;">
      <p class="form-hint" style="margin: 0;" id="eval-editor-count">Showing <%= records.length %> row<%= records.length === 1 ? '' : 's' %>.</p>
      <button type="button" id="eval-add-row" class="btn btn-accent btn-sm">+ Add row</button>
    </div>
  </div>

  <div class="form-card wide data-browser-card" style="max-width: none;">
    <div class="table-scroll eval-editor-scroll">
      <table class="table-simple excel-table" id="eval-editor-table" data-dataset-row-id="<%= datasetRowId %>" data-columns="<%= columns.join('|') %>">
        <thead>
          <tr>
            <% columns.forEach(function (col) { %><th><%= col.replace(/_/g, ' ') %></th><% }); %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% records.forEach(function (r) { %>
            <tr data-record-id="<%= r.id %>">
              <% columns.forEach(function (col) { %>
                <td contenteditable="true" data-column="<%= col %>"><%= r.data[col] === undefined || r.data[col] === null ? '' : r.data[col] %></td>
              <% }); %>
              <td style="white-space: nowrap;">
                <button type="button" class="btn btn-danger btn-sm eval-delete-row">Delete</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- "Add row" opens this as a form instead of inserting a blank row
       directly — every field for the new record, with Cancel (discards,
       nothing is sent) and Save (POSTs the filled-in values as the new
       row and refreshes the four analytics modules next time they're
       opened, same as any other edit here). Hidden by default; toggled by
       the script below. -->
  <div id="eval-add-row-overlay" class="eval-modal-overlay" style="display:none;">
    <div class="eval-modal" role="dialog" aria-modal="true" aria-labelledby="eval-add-row-title">
      <form id="eval-add-row-form">
        <div class="eval-modal-header">
          <h2 id="eval-add-row-title" class="form-title" style="font-size: 19px; margin: 0;">Add new row</h2>
          <p class="form-hint" style="margin: 6px 0 0;">Fill in as many fields as you have — leave the rest blank. Save adds this as a new row and updates the four analytics modules next time you open them.</p>
        </div>
        <div class="eval-modal-body">
          <% columns.forEach(function (col) { %>
            <div class="field">
              <label for="eval-add-field-<%= col %>"><%= col.replace(/_/g, ' ') %></label>
              <input type="text" id="eval-add-field-<%= col %>" name="<%= col %>" data-column="<%= col %>" autocomplete="off" />
            </div>
          <% }); %>
        </div>
        <div id="eval-add-row-alert" class="alert-error" style="display:none;" role="alert"></div>
        <div class="eval-modal-footer">
          <button type="button" id="eval-add-row-cancel" class="btn btn-ghost">Cancel</button>
          <button type="submit" id="eval-add-row-save" class="btn btn-accent">Save</button>
        </div>
      </form>
    </div>
  </div>
<% } %>

<script>
(function () {
  var table = document.getElementById('eval-editor-table');
  if (!table) return; // no columns — nothing to wire up

  var tbody = table.querySelector('tbody');
  var countEl = document.getElementById('eval-editor-count');
  var alertEl = document.getElementById('eval-editor-alert');
  var addBtn = document.getElementById('eval-add-row');
  var columns = table.getAttribute('data-columns').split('|');
  var rowsBase = '/sme-templates/evaluation-dataset/' + table.getAttribute('data-dataset-row-id') + '/rows';

  function showError(message) {
    alertEl.textContent = message;
    alertEl.style.display = '';
  }
  function clearError() {
    alertEl.style.display = 'none';
  }

  function rowCount() {
    return tbody.querySelectorAll('tr').length;
  }
  function refreshCount() {
    var n = rowCount();
    countEl.textContent = 'Showing ' + n + ' row' + (n === 1 ? '' : 's') + '.';
  }
  function refreshDeleteButtons() {
    var disable = rowCount() <= 1;
    Array.prototype.forEach.call(tbody.querySelectorAll('.eval-delete-row'), function (btn) {
      btn.disabled = disable;
      btn.title = disable ? "Can't delete the last remaining row." : '';
    });
  }

  function flashCell(cell, ok) {
    cell.classList.remove('cell-saved', 'cell-error');
    cell.classList.add(ok ? 'cell-saved' : 'cell-error');
    setTimeout(function () { cell.classList.remove('cell-saved', 'cell-error'); }, 900);
  }

  function buildRow(recordId, data) {
    var tr = document.createElement('tr');
    tr.setAttribute('data-record-id', recordId);
    columns.forEach(function (col) {
      var td = document.createElement('td');
      td.setAttribute('contenteditable', 'true');
      td.setAttribute('data-column', col);
      td.textContent = (data && data[col] !== undefined && data[col] !== null) ? data[col] : '';
      wireCell(td);
      tr.appendChild(td);
    });
    var actionsTd = document.createElement('td');
    actionsTd.style.whiteSpace = 'nowrap';
    var delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'btn btn-danger btn-sm eval-delete-row';
    delBtn.textContent = 'Delete';
    wireDeleteButton(delBtn);
    actionsTd.appendChild(delBtn);
    tr.appendChild(actionsTd);
    return tr;
  }

  function wireCell(cell) {
    cell.addEventListener('focus', function () {
      cell.dataset.originalValue = cell.textContent;
      clearError();
    });
    cell.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        cell.blur();
      }
    });
    cell.addEventListener('paste', function (e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text/plain');
      document.execCommand('insertText', false, text);
    });
    cell.addEventListener('blur', function () {
      var newValue = cell.textContent;
      if (newValue === cell.dataset.originalValue) return;
      var tr = cell.closest('tr');
      var recordId = tr.getAttribute('data-record-id');
      var column = cell.getAttribute('data-column');
      tr.classList.add('row-pending');
      fetch(rowsBase + '/' + recordId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ column: column, value: newValue }),
      })
        .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
        .then(function (result) {
          tr.classList.remove('row-pending');
          if (!result.ok) {
            cell.textContent = cell.dataset.originalValue;
            flashCell(cell, false);
            showError((result.body && result.body.message) || "Couldn't save that change — please try again.");
            return;
          }
          flashCell(cell, true);
        })
        .catch(function () {
          tr.classList.remove('row-pending');
          cell.textContent = cell.dataset.originalValue;
          flashCell(cell, false);
          showError('A network error prevented saving that change — please try again.');
        });
    });
  }

  function wireDeleteButton(btn) {
    btn.addEventListener('click', function () {
      if (rowCount() <= 1) return;
      var tr = btn.closest('tr');
      var recordId = tr.getAttribute('data-record-id');
      if (!window.confirm('Delete this row? This cannot be undone.')) return;
      tr.classList.add('row-pending');
      btn.disabled = true;
      fetch(rowsBase + '/' + recordId, { method: 'DELETE' })
        .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
        .then(function (result) {
          if (!result.ok) {
            tr.classList.remove('row-pending');
            btn.disabled = rowCount() <= 1;
            showError((result.body && result.body.message) || "Couldn't delete that row — please try again.");
            return;
          }
          tr.parentNode.removeChild(tr);
          refreshCount();
          refreshDeleteButtons();
        })
        .catch(function () {
          tr.classList.remove('row-pending');
          btn.disabled = rowCount() <= 1;
          showError('A network error prevented deleting that row — please try again.');
        });
    });
  }

  Array.prototype.forEach.call(tbody.querySelectorAll('td[contenteditable="true"]'), wireCell);
  Array.prototype.forEach.call(tbody.querySelectorAll('.eval-delete-row'), wireDeleteButton);
  refreshDeleteButtons();

  // "+ Add row" opens a form (one field per column) instead of inserting
  // a blank row straight away — Cancel discards it with no request sent
  // at all; Save is the only path that actually creates the row.
  var overlay = document.getElementById('eval-add-row-overlay');
  var addForm = document.getElementById('eval-add-row-form');
  var addAlert = document.getElementById('eval-add-row-alert');
  var cancelBtn = document.getElementById('eval-add-row-cancel');
  var saveBtn = document.getElementById('eval-add-row-save');

  function showAddError(message) {
    addAlert.textContent = message;
    addAlert.style.display = '';
  }
  function clearAddError() {
    addAlert.style.display = 'none';
  }

  function openAddModal() {
    clearAddError();
    addForm.reset();
    overlay.style.display = 'flex';
    var firstInput = addForm.querySelector('input');
    if (firstInput) firstInput.focus();
  }
  function closeAddModal() {
    overlay.style.display = 'none';
  }

  addBtn.addEventListener('click', openAddModal);
  cancelBtn.addEventListener('click', closeAddModal);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeAddModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.style.display !== 'none') closeAddModal();
  });

  addForm.addEventListener('submit', function (e) {
    e.preventDefault();
    clearAddError();
    var data = {};
    Array.prototype.forEach.call(addForm.querySelectorAll('input[data-column]'), function (input) {
      data[input.getAttribute('data-column')] = input.value;
    });
    saveBtn.disabled = true;
    cancelBtn.disabled = true;
    fetch(rowsBase, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: data }),
    })
      .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
      .then(function (result) {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        if (!result.ok) {
          showAddError((result.body && result.body.message) || "Couldn't add a new row — please try again.");
          return;
        }
        var tr = buildRow(result.body.row.id, result.body.row.data);
        tbody.appendChild(tr);
        refreshCount();
        refreshDeleteButtons();
        closeAddModal();
      })
      .catch(function () {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        showAddError('A network error prevented adding a new row — please try again.');
      });
  });
})();
</script>
