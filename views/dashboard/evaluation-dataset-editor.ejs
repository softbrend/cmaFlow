<div class="page-title">✏️ <span class="page-title-text">Edit Your Evaluation Dataset</span></div>
<p class="page-subtitle page-subtitle-wide">
  <% if (typeof isCustom !== 'undefined' && isCustom) { %>
    <strong><%= datasetName %></strong> — <%= records.length %> row<%= records.length === 1 ? '' : 's' %>, a dataset you defined yourself. Its columns are the six core columns plus the ones you added, so it is separate from every template copy you hold.
  <% } else { %>
  <% if (categoryLabel) { %><strong><%= categoryLabel %></strong> — <% } %><%= records.length %> row<%= records.length === 1 ? '' : 's' %>, this is your own working copy of this category's template — separate from the shared template CSV, and separate from any other category's copy you hold.
  <% } %>
  <% if (isBlankOrigin) { %>
    You started this copy blank, so every row is your own real data — click any cell to edit it in place, use <strong>Delete</strong> to remove a row you don't want, and <strong>+ Add row</strong> below to add a new one.
  <% } else { %>
    These are already-recorded transactions, so existing rows are locked — you can't edit or delete them here. Use <strong>+ Add row</strong> below to add new records as they happen;
  <% } %>
  new rows are picked up the next time you open one of the four analytics modules, if this copy is your current default dataset.
  <a href="/sme-templates/evaluation-dataset" style="margin-left: 6px;">All your dataset copies</a> ·
  <a href="/sme-templates/define-dataset">Define New Dataset</a> ·
  <a href="/sme-templates">Download SME Templates</a>
</p>

<% if (columns.length === 0) { %>
  <div class="form-card wide data-browser-card" style="max-width: none;">
    <p class="form-hint" style="margin: 0;">This dataset copy has no rows, so there are no columns to show. Go back to Download SME Templates and pick a business category to get a fresh copy to work with.</p>
  </div>
<% } else { %>
  <div class="form-card wide data-browser-card" style="margin-bottom: 18px;">
    <div style="display:flex; align-items:center; justify-content:space-between; gap: 14px; flex-wrap: wrap;">
      <p class="form-hint" style="margin: 0;" id="eval-editor-count">Showing <%= records.length %> row<%= records.length === 1 ? '' : 's' %>.</p>
      <span style="display:inline-flex; gap:8px; flex-wrap:wrap;">
        <% if (typeof isCustom !== 'undefined' && isCustom) { %>
          <button type="button" id="eval-add-column" class="btn btn-outline btn-sm">+ Add column</button>
        <% } %>
        <button type="button" id="eval-add-row" class="btn btn-accent btn-sm">+ Add row</button>
      </span>
    </div>
  </div>

  <div class="form-card wide data-browser-card" style="max-width: none;">
    <div class="table-scroll eval-editor-scroll">
      <table class="table-simple excel-table" id="eval-editor-table" data-dataset-row-id="<%= datasetRowId %>" data-columns="<%= columns.join('|') %>" data-editable="<%= isBlankOrigin ? '1' : '0' %>">
        <thead>
          <tr>
            <% columns.forEach(function (col) { %><th><%= col.replace(/_/g, ' ') %></th><% }); %>
            <% if (isBlankOrigin) { %><th></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% records.forEach(function (r) { %>
            <tr data-record-id="<%= r.id %>">
              <% columns.forEach(function (col) { %>
                <% if (isBlankOrigin) { %>
                  <td contenteditable="true" data-column="<%= col %>"><%= r.data[col] === undefined || r.data[col] === null ? '' : r.data[col] %></td>
                <% } else { %>
                  <td><%= r.data[col] === undefined || r.data[col] === null ? '' : r.data[col] %></td>
                <% } %>
              <% }); %>
              <% if (isBlankOrigin) { %>
                <td style="text-align: right; white-space: nowrap;"><button type="button" class="btn btn-ghost btn-sm eval-delete-row">Delete</button></td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- "Add row" opens this as a form instead of inserting a blank row
       directly — every field for the new record, with Cancel (discards,
       nothing is sent) and Save (POSTs the filled-in values as the new
       row and refreshes the four analytics modules next time they're
       opened, same as any other edit here). Cancel/Save sit in the
       header, top-right, next to the title — pinned there (not at the
       bottom of a long field list) per Brenda's request, so they're
       always visible and clickable without scrolling down first,
       regardless of how many fields a given dataset has. Only the field
       grid below the header scrolls. Hidden by default; toggled by the
       script below. -->
  <div id="eval-add-row-overlay" class="eval-modal-overlay" style="display:none;">
    <div class="eval-modal" role="dialog" aria-modal="true" aria-labelledby="eval-add-row-title">
      <form id="eval-add-row-form">
        <div class="eval-modal-header">
          <div class="eval-modal-header-row">
            <h2 id="eval-add-row-title" class="form-title" style="font-size: 19px; margin: 0;">Add new row</h2>
            <div class="eval-modal-header-actions">
              <button type="button" id="eval-add-row-cancel" class="btn btn-ghost btn-sm">Cancel</button>
              <button type="submit" id="eval-add-row-save" class="btn btn-accent btn-sm">Save</button>
            </div>
          </div>
          <p class="form-hint" style="margin: 6px 0 0;">Fill in as many fields as you have — leave the rest blank. Save adds this as a new row and updates the four analytics modules next time you open them. Scroll down for more fields.</p>
        </div>
        <div id="eval-add-row-alert" class="alert-error" style="display:none; margin: 0 28px 14px;" role="alert"></div>
        <div class="eval-modal-body">
          <% columns.forEach(function (col) {
               var choices = (typeof columnChoices !== 'undefined' && columnChoices) ? columnChoices[col] : null; %>
            <div class="field">
              <label for="eval-add-field-<%= col %>"><%= col.replace(/_/g, ' ') %></label>
              <% if (choices && choices.length) { %>
                <select id="eval-add-field-<%= col %>" name="<%= col %>" data-column="<%= col %>" class="eval-add-choice-select">
                  <option value="">— Select —</option>
                  <% choices.forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
                  <option value="__other__">Other (type a new value)…</option>
                </select>
                <input type="text" class="eval-add-choice-other" data-column="<%= col %>" placeholder="New <%= col.replace(/_/g, ' ') %> value" style="display:none; margin-top:6px;" autocomplete="off" aria-label="New <%= col.replace(/_/g, ' ') %> value" />
              <% } else { %>
                <%
                  // Define New Dataset: a column the owner declared as a date or a number
                  // gets a matching input, so typed values arrive in a form the analytics can read.
                  var itype = (typeof columnInputTypes !== 'undefined' && columnInputTypes && columnInputTypes[col]) ? columnInputTypes[col] : 'text';
                %>
                <input type="<%= itype %>"<%= itype === 'number' ? ' step=any' : '' %> id="eval-add-field-<%= col %>" name="<%= col %>" data-column="<%= col %>" autocomplete="off" />
              <% } %>
            </div>
          <% }); %>
        </div>
      </form>
    </div>
  </div>

  <% if (typeof isCustom !== 'undefined' && isCustom) { %>
    <!-- "+ Add column": adds one column to a dataset the owner defined. Name
         plus a required role; existing rows get an empty value for it. -->
    <div id="eval-add-col-overlay" class="eval-modal-overlay" style="display:none;">
      <div class="eval-modal" role="dialog" aria-modal="true" aria-labelledby="eval-add-col-title" style="max-width: 520px;">
        <form id="eval-add-col-form" novalidate>
          <div class="eval-modal-header">
            <div class="eval-modal-header-row">
              <h2 id="eval-add-col-title" class="form-title" style="font-size: 19px; margin: 0;">Add a column</h2>
              <div class="eval-modal-header-actions">
                <button type="button" id="eval-add-col-cancel" class="btn btn-ghost btn-sm">Cancel</button>
                <button type="submit" id="eval-add-col-save" class="btn btn-accent btn-sm">Add column</button>
              </div>
            </div>
            <p class="form-hint" style="margin: 6px 0 0;">The new column is added to every row, empty until you fill it in. Choose what kind of information it holds so CMA-Flow knows what it means.</p>
          </div>
          <div id="eval-add-col-alert" class="alert-error" style="display:none; margin: 0 28px 14px;" role="alert"></div>
          <div class="eval-modal-body">
            <div class="field">
              <label for="eval-add-col-name">Column name</label>
              <input type="text" id="eval-add-col-name" maxlength="40" placeholder="e.g. Stylist" autocomplete="off" />
            </div>
            <div class="field">
              <label for="eval-add-col-role">What does it hold?</label>
              <select id="eval-add-col-role">
                <option value="">— Choose —</option>
                <% roleOptions.forEach(function (r) { %><option value="<%= r.value %>"><%= r.label %></option><% }); %>
              </select>
            </div>
          </div>
        </form>
      </div>
    </div>
  <% } %>
<% } %>

<script>
(function () {
  // Existing rows are locked — already-recorded transactions, not a live
  // spreadsheet (per Brenda, 3 October 2026) — UNLESS this copy was
  // started blank (isEditable below, from the table's own data-editable
  // attribute, set from isBlankOrigin by routes/templates.js): then every
  // row is the account's own real data, and the click-to-edit-a-cell /
  // per-row Delete wiring below talks to the PATCH/DELETE routes
  // reintroduced in routes/templates.js, scoped there to this same
  // isBlankOrigin check. A prefilled copy's table has no contenteditable
  // cells and no Delete buttons at all (see the EJS above), so isEditable
  // is false there and this script never attempts a PATCH/DELETE call
  // regardless.
  var table = document.getElementById('eval-editor-table');
  if (!table) return; // no columns — nothing to wire up

  var tbody = table.querySelector('tbody');
  var countEl = document.getElementById('eval-editor-count');
  var addBtn = document.getElementById('eval-add-row');
  var columns = table.getAttribute('data-columns').split('|');
  var isEditable = table.getAttribute('data-editable') === '1';
  var rowsBase = '/sme-templates/evaluation-dataset/' + table.getAttribute('data-dataset-row-id') + '/rows';

  function rowCount() {
    return tbody.querySelectorAll('tr').length;
  }
  function refreshCount() {
    var n = rowCount();
    countEl.textContent = 'Showing ' + n + ' row' + (n === 1 ? '' : 's') + '.';
  }

  // Brief visual confirmation on a cell after a PATCH resolves — green
  // flash for success, red for a rejected/failed save (which also
  // restores the cell's previous text, so a failed edit never looks like
  // it silently stuck).
  function flashCell(td, ok) {
    td.classList.remove('cell-saved', 'cell-error');
    td.classList.add(ok ? 'cell-saved' : 'cell-error');
    setTimeout(function () { td.classList.remove('cell-saved', 'cell-error'); }, 1200);
  }

  function wireCell(td) {
    var original = td.textContent;
    td.addEventListener('focus', function () { original = td.textContent; });
    td.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { e.preventDefault(); td.blur(); }
    });
    td.addEventListener('blur', function () {
      var value = td.textContent;
      if (value === original) return;
      var tr = td.closest('tr');
      var recordId = tr.getAttribute('data-record-id');
      var column = td.getAttribute('data-column');
      fetch(rowsBase + '/' + recordId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ column: column, value: value }),
      })
        .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
        .then(function (result) {
          if (!result.ok) {
            td.textContent = original;
            flashCell(td, false);
            return;
          }
          original = value;
          flashCell(td, true);
        })
        .catch(function () {
          td.textContent = original;
          flashCell(td, false);
        });
    });
  }

  function wireDeleteButton(btn) {
    btn.addEventListener('click', function () {
      var tr = btn.closest('tr');
      var recordId = tr.getAttribute('data-record-id');
      if (!window.confirm('Delete this row? This cannot be undone.')) return;
      btn.disabled = true;
      fetch(rowsBase + '/' + recordId, { method: 'DELETE' })
        .then(function (resp) {
          if (!resp.ok) { throw new Error('delete failed'); }
          return resp.json();
        })
        .then(function () {
          tr.parentNode.removeChild(tr);
          refreshCount();
        })
        .catch(function () {
          btn.disabled = false;
          window.alert("Couldn't delete that row — please try again.");
        });
    });
  }

  if (isEditable) {
    Array.prototype.forEach.call(tbody.querySelectorAll('td[contenteditable="true"]'), wireCell);
    Array.prototype.forEach.call(tbody.querySelectorAll('.eval-delete-row'), wireDeleteButton);
  }

  function buildRow(recordId, data) {
    var tr = document.createElement('tr');
    tr.setAttribute('data-record-id', recordId);
    columns.forEach(function (col) {
      var td = document.createElement('td');
      td.textContent = (data && data[col] !== undefined && data[col] !== null) ? data[col] : '';
      if (isEditable) {
        td.setAttribute('contenteditable', 'true');
        td.setAttribute('data-column', col);
        wireCell(td);
      }
      tr.appendChild(td);
    });
    if (isEditable) {
      var actionTd = document.createElement('td');
      actionTd.style.textAlign = 'right';
      actionTd.style.whiteSpace = 'nowrap';
      var delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'btn btn-ghost btn-sm eval-delete-row';
      delBtn.textContent = 'Delete';
      wireDeleteButton(delBtn);
      actionTd.appendChild(delBtn);
      tr.appendChild(actionTd);
    }
    return tr;
  }

  // "+ Add row" opens a form (one field per column) instead of inserting
  // a blank row straight away — Cancel discards it with no request sent
  // at all; Save is the only path that actually creates the row.
  var overlay = document.getElementById('eval-add-row-overlay');
  var addForm = document.getElementById('eval-add-row-form');
  var addAlert = document.getElementById('eval-add-row-alert');
  var cancelBtn = document.getElementById('eval-add-row-cancel');
  var saveBtn = document.getElementById('eval-add-row-save');

  function showAddError(message) {
    addAlert.textContent = message;
    addAlert.style.display = '';
  }
  function clearAddError() {
    addAlert.style.display = 'none';
  }

  // Choice fields (views/dashboard dropdowns built server-side from this
  // column's already-used values, via routes/templates.js's
  // computeColumnChoices()) pair a <select> with a hidden text input for
  // "Other (type a new value)…" — shown only while that option is
  // selected, and the one actually sent for that column when it is.
  Array.prototype.forEach.call(addForm.querySelectorAll('.eval-add-choice-select'), function (sel) {
    var col = sel.getAttribute('data-column');
    var otherInput = addForm.querySelector('.eval-add-choice-other[data-column="' + col + '"]');
    if (!otherInput) return;
    sel.addEventListener('change', function () {
      var isOther = sel.value === '__other__';
      otherInput.style.display = isOther ? '' : 'none';
      if (isOther) otherInput.focus();
    });
  });

  function openAddModal() {
    clearAddError();
    addForm.reset();
    // form.reset() restores every control's VALUE, but not the inline
    // display style the change listener above sets on an "Other" input —
    // without this, reopening after a prior "Other" pick would leave
    // that text box visibly shown even though its paired <select> is
    // back on "— Select —".
    Array.prototype.forEach.call(addForm.querySelectorAll('.eval-add-choice-other'), function (input) {
      input.style.display = 'none';
    });
    overlay.style.display = 'flex';
    var firstField = addForm.querySelector('input, select');
    if (firstField) firstField.focus();
  }
  function closeAddModal() {
    overlay.style.display = 'none';
  }

  addBtn.addEventListener('click', openAddModal);
  cancelBtn.addEventListener('click', closeAddModal);
  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closeAddModal();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.style.display !== 'none') closeAddModal();
  });

  addForm.addEventListener('submit', function (e) {
    e.preventDefault();
    clearAddError();
    var data = {};
    Array.prototype.forEach.call(addForm.querySelectorAll('input[data-column]'), function (input) {
      if (input.classList.contains('eval-add-choice-other')) return; // gathered below, only when its select picked "Other"
      data[input.getAttribute('data-column')] = input.value;
    });
    Array.prototype.forEach.call(addForm.querySelectorAll('select[data-column]'), function (sel) {
      var col = sel.getAttribute('data-column');
      if (sel.value === '__other__') {
        var otherInput = addForm.querySelector('.eval-add-choice-other[data-column="' + col + '"]');
        data[col] = otherInput ? otherInput.value : '';
      } else {
        data[col] = sel.value;
      }
    });
    saveBtn.disabled = true;
    cancelBtn.disabled = true;
    fetch(rowsBase, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: data }),
    })
      .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
      .then(function (result) {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        if (!result.ok) {
          showAddError((result.body && result.body.message) || "Couldn't add a new row — please try again.");
          return;
        }
        var tr = buildRow(result.body.row.id, result.body.row.data);
        tbody.appendChild(tr);
        refreshCount();
        closeAddModal();
      })
      .catch(function () {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        showAddError('A network error prevented adding a new row — please try again.');
      });
  });
})();
</script>

<% if (typeof isCustom !== 'undefined' && isCustom) { %>
<script>
(function () {
  var table = document.getElementById('eval-editor-table');
  var openBtn = document.getElementById('eval-add-column');
  var overlay = document.getElementById('eval-add-col-overlay');
  if (!table || !openBtn || !overlay) return;
  var form = document.getElementById('eval-add-col-form');
  var nameInput = document.getElementById('eval-add-col-name');
  var roleSelect = document.getElementById('eval-add-col-role');
  var alertBox = document.getElementById('eval-add-col-alert');
  var saveBtn = document.getElementById('eval-add-col-save');
  var cancelBtn = document.getElementById('eval-add-col-cancel');
  var url = '/sme-templates/evaluation-dataset/' + table.getAttribute('data-dataset-row-id') + '/columns';

  function open() {
    alertBox.style.display = 'none';
    nameInput.value = '';
    roleSelect.value = '';
    overlay.style.display = '';
    nameInput.focus();
  }
  function close() { overlay.style.display = 'none'; }
  function showError(msg) { alertBox.textContent = msg; alertBox.style.display = ''; }

  openBtn.addEventListener('click', open);
  cancelBtn.addEventListener('click', close);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.style.display !== 'none') close(); });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    alertBox.style.display = 'none';
    saveBtn.disabled = true;
    cancelBtn.disabled = true;
    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: nameInput.value, role: roleSelect.value }),
    })
      .then(function (resp) { return resp.json().then(function (body) { return { ok: resp.ok, body: body }; }); })
      .then(function (result) {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        if (!result.ok) { showError((result.body && result.body.message) || "Couldn't add the column. Please try again."); return; }
        // Reload so the header, every row's new empty cell and the Add-row form all show the new column.
        window.location.reload();
      })
      .catch(function () {
        saveBtn.disabled = false;
        cancelBtn.disabled = false;
        showError('A network error prevented adding the column. Please try again.');
      });
  });
})();
</script>
<% } %>
