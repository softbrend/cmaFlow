<%# Partial: SME Owner-TAM respondents by decision-making involvement and by
    position in the business, completed vs not completed (added 10 October
    2026). Local: ds — services/smeTamCategorySummary.js's
    buildDecisionMakerSummary(). The first three decision-making levels are
    the primary SME decision-makers prioritized in the analysis. %>
<div class="form-card wide" style="max-width: none; margin-bottom: 22px;">
  <div class="form-title" style="font-size: 18px;">Respondents by decision-making involvement and position</div>
  <p class="form-hint">
    <strong><%= ds.primary.registered %></strong> of <%= ds.total %> evaluators are primary SME decision-makers
    (Primary, Joint or Departmental Decision-Maker); <strong><%= ds.primary.completed %></strong> of them completed the TAM questionnaire
    and <strong><%= ds.primary.notCompleted %></strong> have not.
    <% if (ds.notAnswered > 0) { %>
      <%= ds.notAnswered %> evaluator<%= ds.notAnswered === 1 ? ' has' : 's have' %> not answered these questions yet — they'll be asked on their next login.
    <% } %>
  </p>

  <div style="display: grid; grid-template-columns: 1fr; gap: 22px; margin-top: 10px;">
    <div>
      <div class="form-title" style="font-size: 15px; margin-bottom: 6px;">Level of involvement in business decision-making</div>
      <div class="table-scroll">
        <table class="table-simple">
          <thead>
            <tr>
              <th style="min-width: 240px;">Level</th>
              <th style="text-align: right;">Registered</th>
              <th style="text-align: right;">Completed</th>
              <th style="text-align: right;">Not completed</th>
            </tr>
          </thead>
          <tbody>
            <% ds.byAuthority.forEach(function(r) { %>
              <tr>
                <td>
                  <strong><%= r.key %></strong>
                  <% if (r.primary) { %><span class="badge badge-active" style="margin-left: 6px; white-space: nowrap;">Primary</span><% } %>
                  <div style="color: var(--text-muted); font-size: 12.5px;"><%= r.description %></div>
                </td>
                <td style="text-align: right;"><%= r.registered %></td>
                <td style="text-align: right;"><%= r.completed %></td>
                <td style="text-align: right;"><%= r.notCompleted %></td>
              </tr>
            <% }); %>
            <tr style="font-weight: 700;">
              <td>Primary SME decision-makers (first three levels)</td>
              <td style="text-align: right;"><%= ds.primary.registered %></td>
              <td style="text-align: right;"><%= ds.primary.completed %></td>
              <td style="text-align: right;"><%= ds.primary.notCompleted %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <div class="form-title" style="font-size: 15px; margin-bottom: 6px;">Position in the business</div>
      <div class="table-scroll">
        <table class="table-simple">
          <thead>
            <tr>
              <th>Position</th>
              <th style="text-align: right;">Registered</th>
              <th style="text-align: right;">Completed</th>
              <th style="text-align: right;">Not completed</th>
            </tr>
          </thead>
          <tbody>
            <% if (ds.byPosition.length === 0) { %>
              <tr><td colspan="4" style="color: var(--text-muted);">No SME Owner-TAM Evaluator accounts yet.</td></tr>
            <% } %>
            <% ds.byPosition.forEach(function(r) { %>
              <tr>
                <td><%= r.key %></td>
                <td style="text-align: right;"><%= r.registered %></td>
                <td style="text-align: right;"><%= r.completed %></td>
                <td style="text-align: right;"><%= r.notCompleted %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
