<div class="page-title">📊 <span class="page-title-text">SME Owner-TAM Template Activity</span></div>
<p class="page-subtitle">How the SME Owner-TAM Evaluators actually used the provided templates, alongside their TAM ratings. Counts and timestamps only — never dataset contents or file names. Only respondents who gave consent are counted<% if (totals.notConsenting > 0) { %> (<%= totals.notConsenting %> registered account<%= totals.notConsenting === 1 ? '' : 's' %> excluded: consent pending or declined)<% } %>. Activity is logged only after consent, so anything a respondent did before agreeing is not counted.</p>

<div class="form-card wide" style="max-width: none; margin-bottom: 22px;">
  <div class="form-title" style="font-size: 18px;">Totals (<%= totals.consenting %> consenting of <%= totals.registered %> registered)</div>
  <div class="table-scroll">
    <table class="table-simple">
      <thead><tr><th>Measure</th><th>Owners</th><th>Of consenting</th><th>Notes</th></tr></thead>
      <tbody>
        <%
          function pct(n) { return totals.consenting > 0 ? Math.round((n / totals.consenting) * 100) + '%' : '—'; }
          var lines = [
            ['Started with the 50-row sample dataset (chosen at sign-up)', totals.startedSample, ''],
            ['Started with a blank dataset (chosen at sign-up)', totals.startedBlankAtSignup, totals.startedUnknown > 0 ? totals.startedUnknown + ' owner(s) have no starting dataset recorded.' : ''],
            ['Hold a blank copy now / hold a sample copy now', totals.holdBlankCopy + ' / ' + totals.holdSampleCopy, 'Counts owners, not copies; an owner can hold both.'],
            ['Used a prefilled (sample) template', totals.usedPrefilled, ''],
            ['Downloaded the sample CSV (50 rows)', totals.downloadedSample, ''],
            ['Downloaded the blank template', totals.downloadedBlank, 'Headers-only CSV.'],
            ['Started a blank copy in the app', totals.startedBlank, 'Typing their own rows in the editor.'],
            ['Added at least one new row', totals.addedRows, totals.rowsAdded + ' rows added in total.'],
            ['Uploaded a dataset', totals.uploaded, totals.uploadRows + ' rows uploaded in total.'],
            ['Declared an upload to be their real business records', totals.uploadedReal, totals.uploadsReal + ' real upload(s), ' + totals.uploadsSample + ' sample/test upload(s) declared.'],
            ['Uploaded a file matching a template (all template columns present)', totals.uploadedTemplateMatch, 'Closest measure of "uploaded back a self-filled template".'],
            ['…and had downloaded the blank template for that category first', totals.uploadedAfterBlank, 'Strongest evidence of the full blank → filled → uploaded path.'],
            ['Recorded a decision on at least one recommendation', totals.ownersWithDecision, totals.decisions + ' decision(s): ' + totals.decisionsActed + ' already acted, ' + totals.decisionsPlanned + ' plan to act, ' + totals.decisionsDeclined + ' will not act. ' + totals.decisionsWithOutcome + ' with an outcome written down.']
          ];
        %>
        <% lines.forEach(function (l) { %>
          <tr><td><%= l[0] %></td><td><strong><%= l[1] %></strong></td><td><%= typeof l[1] === 'number' ? pct(l[1]) : '' %></td><td style="color: var(--text-muted); font-size: 13px;"><%= l[2] %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="form-hint" style="margin: 12px 0 0;">
    <strong>Decision support (owner-reported):</strong>
    <% if (totals.decisions > 0) { %>
      <%= totals.decisions %> decision(s) from <%= totals.ownersWithDecision %> owner<%= totals.ownersWithDecision === 1 ? '' : 's' %>; mean confidence in the decision <strong><%= totals.avgDecisionConfidence %></strong> / 5; <%= totals.decisionsActed + totals.decisionsPlanned %> of <%= totals.decisions %> (<%= Math.round(100 * (totals.decisionsActed + totals.decisionsPlanned) / totals.decisions) %>%) already acted on or planned.
    <% } else { %>
      No decisions recorded yet.
    <% } %>
  </p>
  <p class="form-hint" style="margin: 12px 0 0;">
    <strong>Data quality of uploads the owner declared real (counts only, mean across owners):</strong>
    <% if (totals.uploadsReal > 0) { %>
      <%= totals.avgCompletenessReal === null ? '—' : totals.avgCompletenessReal + '%' %> of cells filled in, <%= totals.avgDuplicateReal === null ? '—' : totals.avgDuplicateReal + '%' %> repeated rows, <%= totals.avgDateParseReal === null ? 'no date columns' : totals.avgDateParseReal + '% of date values readable' %>.
    <% } else { %>
      No uploads declared as real records yet.
    <% } %>
  </p>
  <p class="form-hint" style="margin: 12px 0 0;">
    <strong>Real-data semantic-role check (from field-role confirmations on uploaded data):</strong>
    <% if (totals.rolesConfirmed > 0) { %>
      <%= totals.ownersWithRoleFeedback %> owner<%= totals.ownersWithRoleFeedback === 1 ? '' : 's' %> reviewed <%= totals.rolesConfirmed %> column<%= totals.rolesConfirmed === 1 ? '' : 's' %>; <%= totals.rolesCorrected %> needed correcting — the engine's suggestion was accepted unchanged for <strong><%= totals.roleAgreementPct %>%</strong> of columns.
    <% } else { %>
      No field-role confirmations on uploaded data yet.
    <% } %>
  </p>
  <p style="margin-top: 12px;"><a class="btn btn-accent btn-sm" href="/admin/sme-tam-activity.csv">Download per-owner CSV</a> <a class="btn btn-ghost btn-sm" href="/admin/sme-tam-decisions.csv">Download decision entries CSV</a></p>
</div>

<div class="form-card wide" style="max-width: none; margin-bottom: 26px;">
  <div class="form-title" style="font-size: 18px;">Per owner</div>
  <p class="form-hint" style="margin: 0 0 8px;">Sorted by surname. Click any column heading to re-sort by it (click again to reverse).</p>
  <div class="table-scroll">
    <table class="table-simple" id="owner-activity-table">
      <thead>
        <tr>
          <th data-sortable>Owner (surname)</th>
          <th data-sortable>Started with</th>
          <th data-sortable>Copies held (sample / blank)</th>
          <th data-sortable>Prefilled used</th>
          <th data-sortable>Blank downloads</th>
          <th data-sortable>Blank started</th>
          <th data-sortable>Rows added</th>
          <th data-sortable>Uploads</th>
          <th data-sortable>Matching template</th>
          <th data-sortable>After blank download</th>
          <th data-sortable>Uploads real / sample</th>
          <th data-sortable>Decisions (mean conf.)</th>
          <th data-sortable>Roles confirmed / corrected</th>
          <th data-sortable>Last activity</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="14" style="color: var(--text-muted);">No consenting SME Owner-TAM Evaluators yet.</td></tr>
        <% } %>
        <% rows.forEach(function (r) { %>
          <tr>
            <td data-sort="<%= r.sort_name %>"><a href="/admin/sme-tam-evaluations/<%= r.account_id %>"><%= r.owner_name || r.username %></a>
              <div style="color: var(--text-muted); font-size: 12.5px;"><%= [r.business_sector, r.business_size].filter(Boolean).join(' · ') %></div></td>
            <td data-sort="<%= r.started_with === 'blank' ? 'blank' : (r.started_with === 'prefilled' ? 'sample' : 'zzz') %>"><%= r.started_with === 'blank' ? 'Blank' : (r.started_with === 'prefilled' ? '50-row sample' : '—') %></td>
            <td data-sort="<%= r.prefilled_copies * 1000 + r.blank_copies %>"><%= r.prefilled_copies %> / <%= r.blank_copies %></td>
            <td data-sort="<%= r.prefilled_template_used %>"><%= r.prefilled_template_used %></td>
            <td data-sort="<%= r.blank_template_downloaded %>"><%= r.blank_template_downloaded %></td>
            <td data-sort="<%= r.blank_started %>"><%= r.blank_started %></td>
            <td data-sort="<%= r.rows_added %>"><%= r.rows_added %><% if (r.rows_added > 0) { %> <span style="color: var(--text-muted); font-size: 12.5px;">(<%= r.rows_added_prefilled %> prefilled, <%= r.rows_added_blank %> blank)</span><% } %></td>
            <td data-sort="<%= r.uploads %>"><%= r.uploads %><% if (r.upload_rows > 0) { %> <span style="color: var(--text-muted); font-size: 12.5px;">(<%= r.upload_rows %> rows)</span><% } %></td>
            <td data-sort="<%= r.uploads_template_match %>"><%= r.uploads_template_match %></td>
            <td data-sort="<%= r.uploads_after_blank %>"><%= r.uploads_after_blank %></td>
            <td data-sort="<%= r.uploads_real * 1000 + r.uploads_sample %>"><%= r.uploads_real %> / <%= r.uploads_sample %></td>
            <td data-sort="<%= r.decisions %>"><%= r.decisions %><% if (r.decisions > 0) { %> <span style="color: var(--text-muted); font-size: 12.5px;">(<%= r.avg_confidence %>)</span><% } %></td>
            <td data-sort="<%= r.roles_confirmed * 1000 + r.roles_corrected %>"><%= r.roles_confirmed %> / <%= r.roles_corrected %></td>
            <td data-sort="<%= r.last_event_at ? new Date(r.last_event_at).getTime() : 0 %>" style="color: var(--text-muted); font-size: 13px;"><%= r.last_event_at ? new Date(r.last_event_at).toLocaleString() : '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="form-hint" style="margin: 12px 0 0;">What this cannot show: decision entries are owner-reported intent and confidence (not measured business results), and "real" is the owner's own declaration — the quality counts show the data is plausible, not that it is accurate. Pair both with a short follow-up interview.</p>
</div>

<div class="form-card wide" style="max-width: none; margin-bottom: 26px;">
  <div class="form-title" style="font-size: 18px;">Decision entries</div>
  <p class="form-hint" style="margin-bottom: 10px;">What owners said they would do with each Prescriptive recommendation, their confidence, and — where they came back — what happened. Owner-written text can identify a business; quote it in the paper only de-identified.</p>
  <div class="table-scroll">
    <table class="table-simple">
      <thead>
        <tr><th>Owner</th><th>Recommendation</th><th>Decision</th><th>Confidence</th><th>Would change</th><th>What happened</th><th>Updated</th></tr>
      </thead>
      <tbody>
        <% if (!decisions || decisions.length === 0) { %>
          <tr><td colspan="7" style="color: var(--text-muted);">No decision entries yet.</td></tr>
        <% } %>
        <% var statusText = { already_acted: 'Already acted', plan_to_act: 'Plans to act', will_not_act: 'Will not act', not_sure: 'Not sure yet' };
           (decisions || []).forEach(function (d) { %>
          <tr>
            <td><%= d.owner_name || d.username %></td>
            <td><%= d.recommendation_label || d.recommendation_key %></td>
            <td><%= statusText[d.action_status] || d.action_status %></td>
            <td><%= d.confidence %> / 5</td>
            <td style="font-size: 13px;"><%= d.intended_change || '—' %></td>
            <td style="font-size: 13px;"><%= d.outcome_text || '—' %></td>
            <td style="color: var(--text-muted); font-size: 13px;"><%= new Date(d.updated_at).toLocaleString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<script>
  (function () {
    var table = document.getElementById('owner-activity-table');
    if (!table) return;
    var heads = table.querySelectorAll('th[data-sortable]');
    var tbody = table.tBodies[0];
    function value(td) {
      var v = td.getAttribute('data-sort');
      if (v === null) v = td.textContent.trim();
      var n = Number(v);
      return (v !== '' && !isNaN(n)) ? n : String(v).toLowerCase();
    }
    function sortBy(idx, dir) {
      var rows = Array.prototype.slice.call(tbody.rows).filter(function (r) { return r.cells.length > idx; });
      var decorated = rows.map(function (r, i) { return { r: r, i: i, v: value(r.cells[idx]) }; });
      decorated.sort(function (a, b) {
        var c = (typeof a.v === 'number' && typeof b.v === 'number') ? a.v - b.v : (a.v < b.v ? -1 : a.v > b.v ? 1 : 0);
        return c !== 0 ? c * dir : a.i - b.i;
      });
      decorated.forEach(function (d) { tbody.appendChild(d.r); });
    }
    heads.forEach(function (th, idx) {
      th.style.cursor = 'pointer';
      th.setAttribute('tabindex', '0');
      th.setAttribute('role', 'button');
      th.title = 'Click to sort by this column';
      function activate() {
        var dir = th.getAttribute('data-dir') === 'asc' ? -1 : 1;
        heads.forEach(function (h) { h.removeAttribute('data-dir'); h.removeAttribute('aria-sort'); h.textContent = h.textContent.replace(/\s[▲▼]$/, ''); });
        th.setAttribute('data-dir', dir === 1 ? 'asc' : 'desc');
        th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        th.textContent = th.textContent + (dir === 1 ? ' ▲' : ' ▼');
        sortBy(idx, dir);
      }
      th.addEventListener('click', activate);
      th.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
    });
  })();
</script>
