<div class="page-title">📋 <span class="page-title-text">End-User Evaluation — Complete</span></div>
<p class="page-subtitle">Thanks — your walkthrough and questionnaire responses are saved. This page is a read-only record of what you submitted.</p>

<div class="ok-box">
  Completed <%= session.completed_at ? new Date(session.completed_at).toLocaleString() : '' %>.
</div>

<div class="form-card wide" style="margin-bottom: 22px;">
  <div class="form-title" style="font-size: 18px;">Walkthrough</div>
  <table class="table-simple">
    <thead><tr><th>#</th><th>Module</th><th>Time on task</th><th>Assistance</th><th>Error</th></tr></thead>
    <tbody>
      <% tasks.forEach(function(t) {
           var l = taskLogs.find(function(x) { return x.task_number === t.number; });
           var secs = l ? (l.time_on_task_seconds || 0) : 0;
           var mins = Math.floor(secs / 60); %>
        <tr>
          <td><%= t.number %></td>
          <td><%= t.moduleLabel %></td>
          <td><%= l && l.completed_at ? mins + 'm ' + (secs % 60) + 's' : '—' %></td>
          <td><%= l && l.needed_assistance ? 'Yes' : 'No' %></td>
          <td><%= l && l.had_error ? 'Yes' : 'No' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<% domains.forEach(function(d) { %>
  <div class="form-card wide" style="margin-bottom: 22px;">
    <div class="form-title" style="font-size: 18px;"><%= d.label %> (<%= d.domain %>)</div>
    <table class="table-simple">
      <thead><tr><th>Item</th><th>Statement</th><th>Rating</th><th>Remark</th></tr></thead>
      <tbody>
        <% d.items.forEach(function(item) {
             var r = responses.get(item.code); %>
          <tr>
            <td><%= item.code %></td>
            <td><%= item.text %></td>
            <td><%= r && r.rating ? r.rating + ' / 5' : '—' %></td>
            <td><%= r && r.remark ? r.remark : '' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% }); %>

<p class="form-hint" style="text-align:center; margin-top: 6px;">
  You can still withdraw your consent and request that your responses above be corrected or erased — contact the
  researcher at <a href="mailto:bmbalala@ndmu.edu.ph">bmbalala@ndmu.edu.ph</a>.
</p>
