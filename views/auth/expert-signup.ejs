<div class="form-card wide">
  <div class="form-title"><img src="/img/cma-flow-icon.png" alt="CMA-Flow" style="width:28px; height:28px; border-radius:7px; background:#fff; padding:2px; vertical-align:-6px; margin-right:8px;" />Create your Expert Evaluator account</div>
  <p class="form-hint">Information captured: username, full name, affiliation, email, the business category you'll evaluate, and password. You'll download that category's CSV template, fill it with a realistic dataset, upload it, run it through CMA-Flow's four analytics modules, and complete a short evaluation afterwards.</p>

  <% if (errors && errors.length) { %>
    <div class="alert-error">
      <ul>
        <% errors.forEach(function(e) { %><li><%= e.msg %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/expert-signup/register" autocomplete="off">
    <div class="field">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" value="<%= old.username || '' %>" required />
    </div>

    <div class="field">
      <label for="full_name">Full name</label>
      <input type="text" id="full_name" name="full_name" value="<%= old.full_name || '' %>" required />
    </div>

    <div class="field">
      <label for="affiliation">Affiliation / organization</label>
      <input type="text" id="affiliation" name="affiliation" value="<%= old.affiliation || '' %>" required />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= old.email || '' %>" required />
    </div>

    <div class="field">
      <label for="business_category">Business category you will evaluate</label>
      <select id="business_category" name="business_category" required>
        <option value="" disabled <%= !old.business_category ? 'selected' : '' %>>Select a business category…</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.name %>" <%= old.business_category === c.name ? 'selected' : '' %>><%= c.name %> — <%= c.examples %></option>
        <% }); %>
      </select>
      <p class="form-hint" style="margin: 7px 0 0;">Pick the category closest to the dataset you're preparing — you'll download its matching CSV template on the next page.</p>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" minlength="8" required />
    </div>

    <div class="field">
      <label for="confirm_password">Confirm password</label>
      <input type="password" id="confirm_password" name="confirm_password" minlength="8" required />
    </div>

    <button type="submit" class="btn btn-accent btn-block">Create account</button>
  </form>

  <div class="form-footer">Already have an account? <a href="/login">Sign in</a></div>
</div>
