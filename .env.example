# Copy this file to .env and fill in your local values.
# .env is already gitignored — never commit real credentials.

# --- Server ---
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# NODE_ENV=production is set automatically by Render (see render.yaml) —
# leave unset for local development.

# --- cmaDB (PostgreSQL) ---
# LOCAL DEVELOPMENT: fill in the discrete DB_* vars below to point at a
# local Postgres install.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmadb
DB_USER=postgres
DB_PASSWORD=your-postgres-password

# Set to "true" only if your local Postgres requires SSL (usually not, for localhost)
DB_SSL=false

# PRODUCTION (Render): set DATABASE_URL instead — db/pool.js prefers it
# over the discrete DB_* vars above when present, and enables SSL
# automatically (Render's managed Postgres requires it). Render sets this
# for you automatically when render.yaml wires the web service to the
# database — you should not need to set it by hand.
# DATABASE_URL=postgres://user:password@host:5432/dbname
